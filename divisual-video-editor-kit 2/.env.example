# ── Transcripción ─────────────────────────────────────────────────────────────
# Usa uno de los dos. ElevenLabs es más preciso para detectar cortes.
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# OpenAI Whisper (alternativa, más barato)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── HyperFrames ───────────────────────────────────────────────────────────────
# Necesario solo para funciones avanzadas de HyperFrames
# https://app.heygen.com/settings/api
HEYGEN_API_KEY=
